# --- Supabase ---
# Project URL and public anon key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER-SIDE ONLY. Never expose to the client or commit this.
# Used by API routes to bypass RLS for admin operations (e.g. sending status updates).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (transactional email) ---
RESEND_API_KEY=your-resend-api-key

# Address that "From" headers use for outgoing client emails. Must be a domain
# verified in your Resend account.
RESEND_FROM_EMAIL="ACCESS Concierge <concierge@yourdomain.com>"

# Internal team inbox that receives "new request" alert emails.
ADMIN_NOTIFICATION_EMAIL=team@yourdomain.com

# --- App ---
# Public base URL of the deployed app, used in email links/templates.
NEXT_PUBLIC_APP_URL=http://localhost:3000
